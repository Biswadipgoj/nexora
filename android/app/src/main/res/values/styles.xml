<?xml version="1.0" encoding="utf-8"?>
<!--
  The web app ships obsidian dark only (design document section 2), so the
  native shell is pinned dark too. It previously extended
  Theme.AppCompat.Light.DarkActionBar and followed the device setting, which
  gave a light status bar and stock Material chrome around a dark app.
-->
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/nexoraCanvas</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- Painting the canvas here stops the white flash between the splash
             screen and the WebView's first frame. -->
        <item name="android:windowBackground">@color/nexoraCanvas</item>
        <item name="android:statusBarColor">@color/nexoraCanvas</item>
        <item name="android:navigationBarColor">@color/nexoraCanvas</item>
        <!-- Light glyphs on a dark bar. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
